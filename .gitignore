# Dependencies
node_modules/

# Build outputs
build/
# dist/ is intentionally committed on this branch so a GitHub-pinned install
# (github:MantaLabsAI/gst-kit#<commit>) gets the prebuilt JS/types without a
# TypeScript build step (consumers install without devDeps). Rebuild with
# `npm run build:ts` and commit the result when the TS source changes.
# The native addon (*.node) stays ignored — it is rebuilt per platform on install.
*.node
*.o
*.obj
*.exe
*.dll
*.so
*.dylib

# GYP and build artifacts
Makefile
*.mk
*.target.mk
*.Makefile
*.xcodeproj
*.vcxproj
*.vcxproj.filters
*.sln

# OS
.DS_Store
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing
coverage/
.nyc_output/

# Environment
.env
.env.local
.env.*.local

# TypeScript
*.tsbuildinfo

# Temporary files
*.tmp
*.temp
.cache/

deno.lock
bun.lock
